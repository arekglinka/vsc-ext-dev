{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "files": {
    "ignore": [
      "output/",
      "output-es/",
      "dist/",
      "media/",
      "node_modules/",
      ".spago/",
      ".cache/",
      ".sisyphus/",
      "scripts/fixtures/",
      ".vscode/",
      "*.vsix"
    ]
  },
  "overrides": [
    {
      "include": ["scripts/smoke.cjs"],
      "linter": {
        "enabled": false
      }
    }
  ]
}
