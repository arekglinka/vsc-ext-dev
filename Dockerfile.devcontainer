# Devcontainer image for vsc-ext-dev — the single definition of the
# development environment, baked (not assembled from features) so a rebuild
# is a straight image build and CI can publish the result to GHCR
# (.github/workflows/devcontainer-image.yml) for pull-fast cold starts.
FROM node:22-slim

# system packages: git (spago), tmux, unzip (install-extension.mjs), zip
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
  ca-certificates curl gnupg unzip zip git tmux \
  && rm -rf /var/lib/apt/lists/*

# GitHub CLI from the official apt repository
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
  -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
  > /etc/apt/sources.list.d/github-cli.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends gh \
  && rm -rf /var/lib/apt/lists/*

# Rust toolchain (fluent-wasm engine): wasm32 for the shipped artifact,
# musl for host-side `cargo test` without a C linker (scripts/test-wasm.sh)
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:$PATH
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --no-modify-path \
  --component rustfmt \
  -t wasm32-unknown-unknown,x86_64-unknown-linux-musl \
  && chmod -R a+rwX /usr/local/rustup /usr/local/cargo

# Bun (per-user for the node user; postCreateCommand installs omo-ai with it)
USER node
ENV BUN_INSTALL=/home/node/.bun PATH=/home/node/.bun/bin:$PATH
RUN curl -fsSL https://bun.sh/install | bash
